# ============================================================
# Informática Destaca - Variables de entorno del BACKEND
# Copia este archivo como .env y ajusta los valores
# ============================================================

# Entorno de ejecución (development | production | test)
NODE_ENV=development

# Puerto donde corre el backend (también sirve el frontend)
PORT=4000

# ------------------------------------------------------------
# BASE DE DATOS
# URI de MongoDB. Ejemplos:
#   Local:      mongodb://127.0.0.1:27017/informatica_destaca
#   Atlas:      mongodb+srv://usuario:password@cluster.mongodb.net/informatica_destaca
# Si Mongoose no puede conectar y ENABLE_MEMORY_DB=true, el
# servidor arranca con una BD en memoria (modo demo temporal).
# ------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/informatica_destaca
ENABLE_MEMORY_DB=true

# ------------------------------------------------------------
# SEGURIDAD
# JWT_SECRET: cadena larga y aleatoria. CÁMBIALA en producción.
# JWT_EXPIRES_IN: duración del token de sesión.
# ------------------------------------------------------------
JWT_SECRET=cambia-esta-clave-secreta-por-una-larga-y-aleatoria-en-produccion
JWT_EXPIRES_IN=8h

# Origen permitido para CORS (frontend en desarrollo independiente)
CORS_ORIGIN=http://localhost:4000

# ------------------------------------------------------------
# SUBIDA DE ARCHIVOS (multimedia)
# Tamaños en bytes. MAX_IMAGE=5MB, MAX_VIDEO=50MB
# ------------------------------------------------------------
MAX_IMAGE_SIZE=5242880
MAX_VIDEO_SIZE=52428800
